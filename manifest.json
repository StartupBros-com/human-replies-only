{
  "manifest_version": 3,
  "name": "x-slop-hide",
  "version": "0.6.0",
  "description": "Hides x.com posts by accounts on a self-updating AI-reply spam list, and can mute them on X at a capped daily pace. No X API.",
  "homepage_url": "https://github.com/StartupBros-com/x-slop-hide",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://clankwall.vogel.dev/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*", "https://mobile.twitter.com/*"],
      "js": ["src/lib.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "x-slop-hide",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "src/settings.html", "open_in_tab": true }
}
