{
  "name": "x-slop-hide",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "Hide x.com posts by accounts on a self-updating AI-reply spam list, and optionally mute them on X at a capped daily pace. No X API.",
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "build": "node scripts/build-userscript.mjs",
    "check": "node scripts/build-userscript.mjs --check && node --check dist/x-slop-hide.user.js && node --test 'test/*.test.mjs'"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "linkedom": "^0.18.15"
  }
}
